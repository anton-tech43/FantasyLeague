# Secrets - never commit
Configuration.xcconfig
*.p8
.env

# Supabase CLI cache (contains DB pooler URL with embedded password)
**/.temp/

# Claude Code per-machine runtime artifacts. .claude/settings.json is
# committed (project-shared permissions); settings.local.json is already
# excluded via user-level git config; these are the leftovers.
.claude/scheduled_tasks.lock
.claude/plans/

# Xcode
*.xcuserdata
*.xcworkspace
# ...except the resolved SPM pins, which must ship so every checkout and CI
# builds against the same Facebook SDK revision.
!ios/GoalDigger.xcodeproj/project.xcworkspace/
!ios/GoalDigger.xcodeproj/project.xcworkspace/xcshareddata/
!ios/GoalDigger.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!ios/GoalDigger.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
build/
.dd/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Swift Package Manager
.build/
Packages/
__pycache__/

# Agent worktrees: local scratch clones, never part of the repo
.claude/worktrees/
# Xcode per-user state
**/xcuserdata/
