# Goal Digger — Backend Environment Variables
# Copy this file to .env and fill in your values.
# These are set as Supabase Edge Function secrets via the dashboard.

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Anon Key (also needed by iOS client)
SUPABASE_ANON_KEY=eyJ...

# Anthropic Claude API (for content generation and review)
ANTHROPIC_API_KEY=sk-ant-...

# API-Football via RapidAPI (Pro plan required, ~$30/month)
API_FOOTBALL_KEY=xxxxxxxxxx

# Apple Push Notifications (set up in Phase 5)
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_P8=<contents of .p8 file, base64 encoded>
APNS_BUNDLE_ID=com.goaldigger.app
APNS_ENVIRONMENT=development
# Change to "production" after App Store approval
