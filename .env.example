# API-Football API Key (Free tier - 100 requests/day)
# Get your key at: https://dashboard.api-football.com
API_FOOTBALL_KEY=your_api_key_here

# Supabase Configuration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Apple Push Notifications (Phase 5 - after Apple Developer enrollment)
APNS_KEY_ID=your_key_id_here
APNS_TEAM_ID=your_team_id_here
APNS_PRIVATE_KEY=your_p8_key_content_here
APNS_BUNDLE_ID=com.goaldigger.app
APNS_ENVIRONMENT=development
