{
    "type": "object",
    "properties": {
        "pass": {
            "type": "boolean",
            "description": "Does this content pass accuracy review?"
        },
        "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence in the fact-check"
        },
        "notes": {
            "type": "string",
            "description": "Summary of the fact-check"
        },
        "errors": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "claim": {
                        "type": "string",
                        "description": "The exact text from the content that is wrong"
                    },
                    "issue": {
                        "type": "string",
                        "description": "What is wrong with it"
                    },
                    "source_says": {
                        "type": "string",
                        "description": "What the source data actually says"
                    },
                    "severity": {
                        "type": "string",
                        "enum": ["critical", "minor"],
                        "description": "Error severity level"
                    }
                },
                "required": ["claim", "issue", "source_says", "severity"]
            },
            "description": "List of factual errors found"
        },
        "unverifiable_claims": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Claims that can't be confirmed from source data but aren't necessarily wrong"
        }
    },
    "required": ["pass", "confidence", "notes"]
}
