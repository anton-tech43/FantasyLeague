# Goal Digger — Backend Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
ANTHROPIC_API_KEY=sk-ant-your_key_here
API_FOOTBALL_KEY=your_rapidapi_key_here

# APNs (available after Apple Developer enrollment)
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_P8=base64_encoded_p8_contents_here
APNS_BUNDLE_ID=com.goaldigger.app
APNS_ENVIRONMENT=development
