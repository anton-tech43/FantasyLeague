-- DO NOT APPLY (2026-10-26). Anton: one pre-game push per match is enough,
-- and the 07:00 matchday reminder now opens Pre-game. Un-pausing the
-- day-before push would make it two. Kept only as a record. PUSH_RULES.md §1.

-- 130: turn the day-before push back on (paused by 126).
-- Apply when 2.3 is live on the App Store, the first version that opens
-- Pre-game from the push (submitted for review 2026-10-07). Check the live
-- version first:
--   curl -s 'https://itunes.apple.com/lookup?bundleId=com.goaldigger.app&country=gb' | grep -o '"version":"[^"]*"'
-- Then rename this file to .sql and run it with psql.
SELECT cron.alter_job((SELECT jobid FROM cron.job WHERE jobname = 'goaldigger-prep-reminder'), active := true);
SELECT jobname, schedule, active FROM cron.job WHERE jobname = 'goaldigger-prep-reminder';
